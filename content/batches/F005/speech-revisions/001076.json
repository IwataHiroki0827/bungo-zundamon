{
  "__brand": "F005SpeechRevisionSet",
  "items": [
    {
      "candidateId": "yK_DJx73I1pv1-b-TraS099LDtA4lJcGC5BKZeikmD4",
      "displayText": "「我が眼の前に、わが死ぬべき折の様を想い見る人こそ幸あれ。日毎夜毎に死なんと願え。やがては神の前に行くなる吾の何を恐るる……」",
      "revisions": [],
      "speechSha256": "d41dca52b9c606aeb0d7fa368f13945cd6b63460fec3aa200750219ae31e5fb7",
      "speechText": "「我が眼の前に、わが死ぬべき折の様をおもい見る人こそさちあれ。日毎夜毎に死なんと願え。やがては神の前に行くなる吾の何を恐るる……」",
      "workId": "001076"
    },
    {
      "candidateId": "eqQ8dvpX_R81yA9lp9NLaYBFDEPoypIAZfQRpuZjAKQ",
      "displayText": "「アーメン」",
      "revisions": [],
      "speechSha256": "21cce375a15565191e019c29f59b8ea6932ea0bc3c1d6a36dab2d0c695dd6785",
      "speechText": "「アーメン」",
      "workId": "001076"
    },
    {
      "candidateId": "bUL8jhVHRlBueQGxXCV2iNagewK4RUOOd1AF39uz6kU",
      "displayText": "「朝ならば夜の前に死ぬと思え。夜ならば翌日ありと頼むな。覚悟をこそ尊べ。見苦しき死に様ぞ恥の極みなる……」",
      "revisions": [],
      "speechSha256": "15831c788b767c060d36b0901bc2cdd2e5faabee36220014db3a1750123db9fe",
      "speechText": "「朝ならば夜の前に死ぬと思え。夜ならばあすありと頼むな。覚悟をこそとうとべ。見苦しき死にざまぞ恥の極みなる……」",
      "workId": "001076"
    },
    {
      "candidateId": "SB92rAARJ35IDlPFBGjv99LpGLSiNSMxojJP73mqFH4",
      "displayText": "「アーメン」",
      "revisions": [],
      "speechSha256": "21cce375a15565191e019c29f59b8ea6932ea0bc3c1d6a36dab2d0c695dd6785",
      "speechText": "「アーメン」",
      "workId": "001076"
    },
    {
      "candidateId": "eL4U-q01piMRhJCfd43e0gERu5C_QEoEOeDv4-p-Db4",
      "displayText": "「今日もまたこうして暮れるのか」",
      "revisions": [],
      "speechSha256": "532166fee3388519f623d7e00e806f8aa7829afdb7f2f44b4b4790c7e99fc330",
      "speechText": "「きょうもまたこうして暮れるのか」",
      "workId": "001076"
    },
    {
      "candidateId": "xXFt-eiuCBjJVO2Vhpzr94qBv8gZIT8w5jgVXEuOtk0",
      "displayText": "「寒い」",
      "revisions": [],
      "speechSha256": "4ae0c462c6d139edfff441957ebada1678390c9ce07eb4bd6f4af85ae802817b",
      "speechText": "「寒い」",
      "workId": "001076"
    },
    {
      "candidateId": "2vJyqDTX3CYp6tfGwtdOCH7Dng3JNg1X8CuPZhR4ek8",
      "displayText": "「命さえ助けてくるるなら伯父様に王の位を進ぜるものを」",
      "revisions": [],
      "speechSha256": "2f8a08ca47fe98728b3633c9b8c8aebfd9c2f64ee27650befdc74fde566bed43",
      "speechText": "「命さえ助けてくるるなら伯父様に王の位を進ぜるものを」",
      "workId": "001076"
    },
    {
      "candidateId": "u6-b086xOvwowvGiQCenD-XsDk-JxZABjtpiQii5Hak",
      "displayText": "「母様に逢いたい」",
      "revisions": [],
      "speechSha256": "0a694f9b9ce50cb61e80d3e1a3dbf64693f75832732f5d861791a78ad1ee832e",
      "speechText": "「ははさまにあいたい」",
      "workId": "001076"
    },
    {
      "candidateId": "Y64t3PUfRWeX105yvjuySlur8ClM68d0CNvTWy4Rxr4",
      "displayText": "「逢う事を許されてか」",
      "revisions": [],
      "speechSha256": "06974891a83d407dec9c0382dc7853be15099eb15feb6ccdf761cb1a2e5ba450",
      "speechText": "「逢う事を許されてか」",
      "workId": "001076"
    },
    {
      "candidateId": "WLgrm674AGVn8oMm9saa1jN_Jd3ldQTHPjQwww-wUuA",
      "displayText": "「否」",
      "revisions": [],
      "speechSha256": "9ce3e5dc0e8e31d952770b86c2a3a99d825c98a942506e44f2f94f76aa12c76e",
      "speechText": "「いな」",
      "workId": "001076"
    },
    {
      "candidateId": "VMU9f6tOcaR2SusGYJnjUKnliO9U9-ttMjJmBONVu9k",
      "displayText": "「逢わせまつらんと思えど、公けの掟なればぜひなしと諦めたまえ。私の情売るは安き間の事にてあれど」",
      "revisions": [],
      "speechSha256": "43a5020b6a6fe341759b429c9bae76dd214865a25ea278fc56cf6116cbd25363",
      "speechText": "「逢わせまつらんと思えど、公けのおきてなればぜひなしとあきらめたまえ。わたくしのなさけ売るは安きまの事にてあれど」",
      "workId": "001076"
    },
    {
      "candidateId": "KkFw9uRKNDzjUwh0FgTLeuCKKkRki6txtoZAlDEl1QM",
      "displayText": "「ただ束の間を垣間見んとの願なり。女人の頼み引き受けぬ君はつれなし」",
      "revisions": [],
      "speechSha256": "8325c7c70a76d65ac49adae656953786b4417d875957cc616a9008d440189afc",
      "speechText": "「ただつかのまをかいま見んとの願なり。にょにんの頼み引き受けぬ君はつれなし」",
      "workId": "001076"
    },
    {
      "candidateId": "Dkj1tbk1L0ugPiU5RMklGDv13ZULkLwdu4bXf0negZw",
      "displayText": "「牢守りは牢の掟を破りがたし。御子らは変る事なく、すこやかに月日を過させたもう。心安く覚して帰りたまえ」",
      "revisions": [],
      "speechSha256": "06d6d75af767177dc983f873eb8c1e165b8be7b32e63e2e75880037a13fd59c3",
      "speechText": "「ろうもりは牢のおきてを破りがたし。みこらは変る事なく、すこやかに月日を過させたもう。心安くおぼして帰りたまえ」",
      "workId": "001076"
    },
    {
      "candidateId": "MjAQgzfDYaNube0SESSy6fN5hIYgTrVU4emZkHuY5to",
      "displayText": "「いかにしても逢う事は叶わずや」",
      "revisions": [],
      "speechSha256": "f6a0f9c663c419555c1420b289cb35814ecf89afa1ee25b1943c82851f664502",
      "speechText": "「いかにしても逢う事はかなわずや」",
      "workId": "001076"
    },
    {
      "candidateId": "BJmH7EXhxBQrjJMxnfIq5kMUXP9Arl1uYClWIRm5kaE",
      "displayText": "「御気の毒なれど」",
      "revisions": [],
      "speechSha256": "0d6296f8118e8a25e280a4c4e4d831ee56533061675aa87275750e6b61e52388",
      "speechText": "「御気の毒なれど」",
      "workId": "001076"
    },
    {
      "candidateId": "EG59FfUgOEY1pxzy-eVq9KWNMnmckBNxQkPrHANqjpc",
      "displayText": "「黒き塔の影、堅き塔の壁、寒き塔の人」",
      "revisions": [],
      "speechSha256": "9db17ddea6e007e5a218a3c51e8dee353cb6a9049f9702c1e27d2eb540c6c5c4",
      "speechText": "「黒き塔の影、堅き塔の壁、寒き塔の人」",
      "workId": "001076"
    },
    {
      "candidateId": "dfus5GNtikEPCV_uljHDEi5-7EpwrJvpYD_uhk-CUQ8",
      "displayText": "「日は暮れた」",
      "revisions": [],
      "speechSha256": "0dd97f8b2b5700b327e9b2ee019b6052ec6183a19bf0b40d1e84d452c9353577",
      "speechText": "「日は暮れた」",
      "workId": "001076"
    },
    {
      "candidateId": "rUn7rzt46cjx2Oh0RcfPpV0bDp_Dwyzo3baCXMjoPwY",
      "displayText": "「昼の世界に顔は出せぬ」",
      "revisions": [],
      "speechSha256": "b51ee53aff90bea43fd028a0a6bc7e856a802ac3f4fcf04e416320c062e5ce85",
      "speechText": "「昼の世界に顔は出せぬ」",
      "workId": "001076"
    },
    {
      "candidateId": "u6IlFMhNIuodK4l4VzTyVzjIv7318b6HOrchI2A8w7U",
      "displayText": "「人殺しも多くしたが今日ほど寝覚の悪い事はまたとあるまい」",
      "revisions": [],
      "speechSha256": "483bb080c427c8245d37ea66e72a4c9b3317baaa08121486cdf7d26d03a2bae9",
      "speechText": "「人殺しも多くしたが今日ほどねざめの悪い事はまたとあるまい」",
      "workId": "001076"
    },
    {
      "candidateId": "oPanaU_f0HnkhL7D_5PwYziuleubt7W66IUH-tCJM1Q",
      "displayText": "「タペストリの裏で二人の話しを立ち聞きした時は、いっその事止めて帰ろうかと思うた」",
      "revisions": [],
      "speechSha256": "c1b35d13893966988a12c0f799b027f5103cc888eef3fb44a823b71b570aecc6",
      "speechText": "「タペストリのうらで二人の話しを立ち聞きした時は、いっその事やめて帰ろうかと思うた」",
      "workId": "001076"
    },
    {
      "candidateId": "ZIWAA9mZ_bm84sdjNbeDrbNsgTJ2_sspEJ-XGqniUUc",
      "displayText": "「絞める時、花のような唇がぴりぴりと顫うた」",
      "revisions": [],
      "speechSha256": "69f762f292ecc71700e49658d588e34a93dbb175dbdc95b4ab916be005bc8cf3",
      "speechText": "「しめる時、花のようなくちびるがぴりぴりとふるうた」",
      "workId": "001076"
    },
    {
      "candidateId": "NCmdy8VKoVmJEa397ngFLqKhm042U_uGDPiLn7iKZUs",
      "displayText": "「透き通るような額に紫色の筋が出た」",
      "revisions": [],
      "speechSha256": "d88cffa0a1cb9b0717c61301edf38b2f7ef51e42c8a69ee9dac583687e5af72a",
      "speechText": "「すき通るようなひたいに紫色の筋が出た」",
      "workId": "001076"
    },
    {
      "candidateId": "EQsfsN8sPPKSeD-ZdzzvUoUgACfNC9lqWXn6y73DPXo",
      "displayText": "「あの唸った声がまだ耳に付いている」",
      "revisions": [],
      "speechSha256": "271dfa7771ad3ff1d9c6d2d15688331226b3b47bea6e83e283d5ba32a4c4b5f5",
      "speechText": "「あのうなった声がまだ耳に付いている」",
      "workId": "001076"
    },
    {
      "candidateId": "4ZVRQAbiHnmVAYrATi_x9xVVUaVYObo5h3T_Ce5JQmc",
      "displayText": "「父と子と聖霊の名によって、我れヘンリーはこの大英国の王冠と御代とを、わが正しき血、恵みある神、親愛なる友の援を藉りて襲ぎ受く」",
      "revisions": [],
      "speechSha256": "8c585b8fdf75274469493626d1a59f8a49c88efe66b51c16c19af3c9b88b9549",
      "speechText": "「父と子と聖霊の名によって、我れヘンリーはこの大英国の王冠と御代とを、わが正しき血、恵みある神、親愛なる友のたすけをかりてつぎ受く」",
      "workId": "001076"
    },
    {
      "candidateId": "Ij7p-1O-QJZ5x5t5gYydk1n3KU-kIwDFR-FzAuYnzkA",
      "displayText": "「あらずあらず。リチャードは断食をして自らと、命の根をたたれたのじゃ」",
      "revisions": [],
      "speechSha256": "27fdd359abc37b51e775c0824680bcafbeb7778044c2572c7d55c77e6e00fd84",
      "speechText": "「あらずあらず。リチャードはだんじきをしてみずからと、命の根をたたれたのじゃ」",
      "workId": "001076"
    },
    {
      "candidateId": "HbnzG6wAbZhWhnpsyIwAW1xk8U_qqvMNN-awsq-JNCE",
      "displayText": "「あなたは日本人ではありませんか」",
      "revisions": [],
      "speechSha256": "3a5b180d0d4f796df296cfa13465935dc7049109ff5b89d610326eba07213a10",
      "speechText": "「あなたは日本人ではありませんか」",
      "workId": "001076"
    },
    {
      "candidateId": "5TatYK7Ep8PwfmNoSZdFhmfnA9VS-uFfGrtNc35vfgc",
      "displayText": "「鴉が、鴉が」",
      "revisions": [],
      "speechSha256": "b145f5b0bcd6f5a447f72ed4ccd82068a37220b20ecd5919b09f749ce4310791",
      "speechText": "「からすが、鴉が」",
      "workId": "001076"
    },
    {
      "candidateId": "gRCXuoxwloon-ahYTbqmr5vNu1PqqHAFhCinXkpfNPI",
      "displayText": "「鴉が寒むそうだから、麺麭をやりたい」",
      "revisions": [],
      "speechSha256": "b827a43730bfb01bd0a87c6daedc7ba7f96bd24d792199caf58721056c978485",
      "speechText": "「鴉がさむそうだから、パンをやりたい」",
      "workId": "001076"
    },
    {
      "candidateId": "nPYivNXFOvoac7Pdpp7Q8GIC9z6bn67I7jJ1xB3VqSE",
      "displayText": "「あの鴉は何にもたべたがっていやしません」",
      "revisions": [],
      "speechSha256": "ac48295567cd5f49dc6c2c7421ac9e6d8723d05db3105a5f5d9894b8f509c355",
      "speechText": "「あの鴉は何にもたべたがっていやしません」",
      "workId": "001076"
    },
    {
      "candidateId": "sk7tuxPs8O9gZR65UaRuRisonIs-mfAuG3-NyaNlfJU",
      "displayText": "「なぜ」",
      "revisions": [],
      "speechSha256": "b70b02c98d3f4c116731660d381a76234e39f8644690a90db6ce9697dd51c9e0",
      "speechText": "「なぜ」",
      "workId": "001076"
    },
    {
      "candidateId": "2y-T0aEOdM1GLLVvKwlOjl4k6a8Awjt7ebhY0kshqQg",
      "displayText": "「あの鴉は五羽います」",
      "revisions": [],
      "speechSha256": "b003bad16f0e42ef289072a5702a8600cdd1f1ed06db5e81b3d621801736e4ce",
      "speechText": "「あの鴉は五羽います」",
      "workId": "001076"
    },
    {
      "candidateId": "ukrlXox5GckHBHJApNNcSo2u_98MJbk27O_fSxVqG-o",
      "displayText": "「こう毎日のように舟から送って来ては、首斬り役も繁昌だのう」",
      "revisions": [],
      "speechSha256": "6bc66beab2c5022a2ddbf78fb34cc50c498e705dda68a6fe9ccd5bfde6b20c57",
      "speechText": "「こう毎日のように舟から送って来ては、くびきり役もはんじょうだのう」",
      "workId": "001076"
    },
    {
      "candidateId": "B_kG9riYBVw5YE2XY6OErSVkLyFjYiRfnq5JIh8j3FY",
      "displayText": "「そうさ、斧を磨ぐだけでも骨が折れるわ」",
      "revisions": [],
      "speechSha256": "7488ae486fa53729883efd83d69624de46756c58356574ba0d775a7b96545d21",
      "speechText": "「そうさ、斧をとぐだけでも骨が折れるわ」",
      "workId": "001076"
    },
    {
      "candidateId": "3NuahzRssnUFPOvvZ4RSZ6U-RLWCvMM6SdxguBgs6VU",
      "displayText": "「昨日は美しいのをやったなあ」",
      "revisions": [],
      "speechSha256": "75f4253a333e09b35d8fdebf28a955e6d1d069d43a560282ed08526e870f8a9c",
      "speechText": "「きのうは美しいのをやったなあ」",
      "workId": "001076"
    },
    {
      "candidateId": "tcmu4zW9GkVJqHPvlU_zLjusAjSitozVG9YiaKhxNrQ",
      "displayText": "「いや顔は美しいが頸の骨は馬鹿に堅い女だった。御蔭でこの通り刃が一分ばかりかけた」",
      "revisions": [],
      "speechSha256": "fecf39835d49f6af9bfe36ca38c596448e7098f073cf949d67f252614b2aa74e",
      "speechText": "「いや顔は美しいがくびの骨は馬鹿に堅い女だった。御蔭でこの通り刃が一分ばかりかけた」",
      "workId": "001076"
    },
    {
      "candidateId": "pxhduKFCohHpWE1goIwUDuDJBrMrttJdw7IrBZ_1EVk",
      "displayText": "「あすは誰の番かな」",
      "revisions": [],
      "speechSha256": "c85d067e334df82d225556ba38110691bd6fcf9ea5d3a4c81c94ab7668930fad",
      "speechText": "「あすは誰の番かな」",
      "workId": "001076"
    },
    {
      "candidateId": "7oCP8GvyN4XakPnafTanpBWhq5FURnk3m5owWIexKNs",
      "displayText": "「あすは例の婆様の番さ」",
      "revisions": [],
      "speechSha256": "46537915a269e2691eeded7ee67514fcec991c24ae85f52f141c5fa9f50afc21",
      "speechText": "「あすは例のばあさまの番さ」",
      "workId": "001076"
    },
    {
      "candidateId": "KbLSgcXENtCCUzvsvqA8_vY8b-P250t5osGRNcrvAg8",
      "displayText": "「アハハハもう善かろう」",
      "revisions": [],
      "speechSha256": "d48580d8561adb7d6183b1eafe8ab5f29b24476e706f1c15163c7b6e3d295466",
      "speechText": "「アハハハもうよかろう」",
      "workId": "001076"
    },
    {
      "candidateId": "X3asUSUsrzlgzrUpF2WQaejX83qdbn6mmZdl567EVHk",
      "displayText": "「婆様ぎりか、ほかに誰もいないか」",
      "revisions": [],
      "speechSha256": "fa1f73ed17217b8621a7f7c0e19cd9f0ba255df9015fb3212ba5ff6e6309674a",
      "speechText": "「ばあさまぎりか、ほかに誰もいないか」",
      "workId": "001076"
    },
    {
      "candidateId": "nzUsy8KEda5vqKi2k0BLsSbW4fWbmYiMY_3u0n5NR5M",
      "displayText": "「それから例のがやられる」",
      "revisions": [],
      "speechSha256": "d782c1c4c3885528e1fa9d7bba1b89b5fd0b8d285e3618a47a84b0db9cfea6bb",
      "speechText": "「それから例のがやられる」",
      "workId": "001076"
    },
    {
      "candidateId": "8FL6D4zzgoJpKI6EEVkSjoZutoEkA7Rpe0-yAFGJq0w",
      "displayText": "「気の毒な、もうやるか、可愛相にのう」",
      "revisions": [],
      "speechSha256": "34a9ee99c43f36b2703506b85c4d67f5789140ce0e8b43645b206e568d19230b",
      "speechText": "「気の毒な、もうやるか、かわいそうにのう」",
      "workId": "001076"
    },
    {
      "candidateId": "kr3zyeskScFP6XJIrFM-Fx5QzjsTEwzBVQ4VG5v0ZRM",
      "displayText": "「気の毒じゃが仕方がないわ」",
      "revisions": [],
      "speechSha256": "c68b072fbfdc6b476172e0c8f22ed0908cec08ea0212d07cb713da4b16971828",
      "speechText": "「気の毒じゃが仕方がないわ」",
      "workId": "001076"
    },
    {
      "candidateId": "9YiADWLIojhVhz5E6Rjz0EYRI3sGLjohdJ8YuQhCzFo",
      "displayText": "「あそこに犬がかいてある」",
      "revisions": [],
      "speechSha256": "9ae44f597e15db65177d98f3699da91054dc6606f0697f28e25a0f3326cfcd4a",
      "speechText": "「あそこに犬がかいてある」",
      "workId": "001076"
    },
    {
      "candidateId": "mau3xdoG-NTkV0tjtnF55osL_l1v_MxD_kA2-Yg28YA",
      "displayText": "「犬ではありません。左りが熊、右が獅子でこれはダッドレー家の紋章です」",
      "revisions": [],
      "speechSha256": "7e3cf733141b657f970de29730069262d389d984a7f401a6dc91120f333abad6",
      "speechText": "「犬ではありません。左りが熊、右がししでこれはダッドレーけの紋章です」",
      "workId": "001076"
    },
    {
      "candidateId": "xmnk4w2wcsj14UFoLA4XkVSsbz5_q3ibSeqKjK84lhc",
      "displayText": "「この紋章を刻んだ人はジョン・ダッドレーです」",
      "revisions": [],
      "speechSha256": "6d52c44dff065fb0a4b4328cfb453f626e39f10848da45be73aa7b9c27bee6f4",
      "speechText": "「この紋章をきざんだ人はジョン・ダッドレーです」",
      "workId": "001076"
    },
    {
      "candidateId": "Dy_u2R5QAQKsy5LZSCP-mCSytiouqClraneFTZFu0p4",
      "displayText": "「ジョンには四人の兄弟があって、その兄弟が、熊と獅子の周囲に刻みつけられてある草花でちゃんと分ります」",
      "revisions": [],
      "speechSha256": "3ddfc2dc6bf13dcd2e8f8a9d886e0c085d9f0b250c5d8cb46c04e594334864ab",
      "speechText": "「ジョンには四人の兄弟があって、その兄弟が、熊と獅子のまわりに刻みつけられてある草花でちゃんと分ります」",
      "workId": "001076"
    },
    {
      "candidateId": "sSulFnt1FnteLDIBQgCN6CO2pReyTmZf2Bb-XNWkHcM",
      "displayText": "「ここにあるのは Acorns でこれは Ambrose の事です。こちらにあるのが Rose で Robert を代表するのです。下の方に忍冬が描いてありましょう。忍冬は Honeysuckle だから Henry に当るのです。左りの上に塊っているのが Geranium でこれは G……」",
      "revisions": [],
      "speechSha256": "b7f2ebcb1f11837637eceb512c5170a4fd75e1c5a049b4ea4e6d7b1ce744fa01",
      "speechText": "「ここにあるのは Acorns でこれは Ambrose の事です。こちらにあるのが Rose で Robert を代表するのです。下の方ににんどうがかいてありましょう。忍冬は Honeysuckle だから Henry に当るのです。左りの上にかたまっているのが Geranium でこれは G……」",
      "workId": "001076"
    },
    {
      "candidateId": "ozIdX1hszVs2i4oyaOXdUHMMSObOm3wVUSTUE4DqgZk",
      "displayText": "「わが夫ギルドフォード・ダッドレーはすでに神の国に行ってか」",
      "revisions": [],
      "speechSha256": "b036813e8a6c5f7c0b14a7fe34e11b59deed14fe87336e2f6e2fac6a70f5130f",
      "speechText": "「わがおっとギルドフォード・ダッドレーはすでに神の国に行ってか」",
      "workId": "001076"
    },
    {
      "candidateId": "6ft4YJ6p2yI7uqLOM-1IJwHljHZDGSC5X-bL6BX7XXo",
      "displayText": "「知り申さぬ」",
      "revisions": [],
      "speechSha256": "d751d35dc33e49a54d6adb82035fcfd785eed84c84906c4a5b6e2619ac45948d",
      "speechText": "「知り申さぬ」",
      "workId": "001076"
    },
    {
      "candidateId": "gSIu8k2vDe0quKXH8gJe9OOF1bh6NCQn5D7Dco1NypI",
      "displayText": "「まだ真との道に入りたもう心はなきか」",
      "revisions": [],
      "speechSha256": "d636d0e2763029e0bdda8a7658e9e0ab50c5c1a90e956b1727ca8e328fe30c6d",
      "speechText": "「まだまことの道に入りたもう心はなきか」",
      "workId": "001076"
    },
    {
      "candidateId": "nBwV4EiI4fVwXq7alll7p8Jy0KCDOwG787RNOqUioGQ",
      "displayText": "「まこととは吾と吾夫の信ずる道をこそ言え。御身達の道は迷いの道、誤りの道よ」",
      "revisions": [],
      "speechSha256": "72ac615aa63a03febcda9c2cdf565044b6c4405d9b4ae6268467aaa43db40eb5",
      "speechText": "「まこととは吾と吾おっとの信ずる道をこそ言え。御身達の道は迷いの道、誤りの道よ」",
      "workId": "001076"
    },
    {
      "candidateId": "bgCkvr9S_wUcCT5KHbkui6l4jC4cGqt4-_qtnVWkz8E",
      "displayText": "「吾夫が先なら追いつこう、後ならば誘うて行こう。正しき神の国に、正しき道を踏んで行こう」",
      "revisions": [],
      "speechSha256": "bee3d5375a5135c8ea42c75558472048c44a82c866fdb8d5abceefb07cce9d95",
      "speechText": "「吾夫が先なら追いつこう、あとならばさそうて行こう。正しき神の国に、正しき道を踏んで行こう」",
      "workId": "001076"
    },
    {
      "candidateId": "FuV9D0XskJWmC7Au-KPa8RnppJ1DiEGHxUYM-Y863ZQ",
      "displayText": "「今一時間早かったら……。この三本のマッチが役に立たなかったのは実に残念である」",
      "revisions": [],
      "speechSha256": "471e440c7f7806450cd6bfb66db6fd282b072e266760f5e2e050d527f2a938ad",
      "speechText": "「今一時間早かったら……。この三本のマッチが役に立たなかったのは実に残念である」",
      "workId": "001076"
    },
    {
      "candidateId": "e8SiZl8O80KkyeRfyzsRaacJi12sT6FHGSxnCbpaakA",
      "displayText": "「あれは奉納の鴉です。昔しからあすこに飼っているので、一羽でも数が不足すると、すぐあとをこしらえます、それだからあの鴉はいつでも五羽に限っています」",
      "revisions": [],
      "speechSha256": "a812f7172ebf204d7ee1a7690a9a196095f74b26ffb58831e81687635abd6926",
      "speechText": "「あれは奉納の鴉です。昔しからあすこに飼っているので、一羽でも数が不足すると、すぐあとをこしらえます、それだからあの鴉はいつでも五羽に限っています」",
      "workId": "001076"
    },
    {
      "candidateId": "06PB_zGJU9HVm_B1H4aRi2-JoQbXoi0sX92c8v0LTyI",
      "displayText": "「ええあの落書ですか、つまらない事をしたもんで、せっかく奇麗な所を台なしにしてしまいましたねえ、なに罪人の落書だなんて当になったもんじゃありません、贋もだいぶありまさあね」",
      "revisions": [],
      "speechSha256": "f5c40b042c28c10e9d66da247888c93dbb58d94350ee28b695d0e4851e900ab5",
      "speechText": "「ええあのらくがきですか、つまらない事をしたもんで、せっかく奇麗な所を台なしにしてしまいましたねえ、なにざいにんの落書だなんてあてになったもんじゃありません、にせもだいぶありまさあね」",
      "workId": "001076"
    },
    {
