        "estimatedBytes": 46844,
        "existing": null,
        "speechSha256": "e50b4d9d8cbc4b401d3d914bf2cdd27c073237eae135fd042ff337e7ff530141",
        "speechText": "「あっち」"
      },
      {
        "action": "generate",
        "audioId": "0c601cac5baacadcd3a466ee39e3b65c625ece3a1d51ad41e4194cfcb6c71a69",
        "candidateIds": [
          "fqE4RoZ7K8dL5BQV80UiOhBBfEiCJxa7CPsvVA75UiM"
        ],
        "estimatedBytes": 224588,
        "existing": null,
        "speechSha256": "c692636fb884c2c61a0a357e0b38ba5f934441b79d3b7e0725845dd95f94ba10",
        "speechText": "「さあ、頭もだが、どうだろう、物になるだろうか」"
      },
      {
        "action": "generate",
        "audioId": "0ebf0067e2414d9703ce1baa39a449b024b9c80b920f1fad9596dd0843f421fe",
        "candidateIds": [
          "Gbe1EMVL1cqYlRThwzpdEQdEK4nZW0fln8SrDKyrczM"
        ],
        "estimatedBytes": 243308,
        "existing": null,
        "speechSha256": "61768c51b4b065fcf65a70d27abedcf79ad357bc76b56cfb6451799b23b560b8",
        "speechText": "「もう少し行くと解る。――ちょうどこんな晩だったな」"
      },
      {
        "action": "generate",
        "audioId": "1038798e851beae167758b6866b28307938ca61ac087c11dd23f8c3389b900db",
        "candidateIds": [
          "nOKFQwdgOQCwzU27AGQb-XgOOrlvk0FO-qJNFx3jEJg"
        ],
        "estimatedBytes": 74924,
        "existing": null,
        "speechSha256": "8375b4160c00f7aa5518cd06600e4cb341bc8fe1621e160d6d0fec0aabfe202a",
        "speechText": "「御父様はどこ」"
      },
      {
        "action": "generate",
        "audioId": "153e5e9bf9f6ee0120be906c7e184bcfca84c57cb4bf70eb75f6438d6a924184",
        "candidateIds": [
          "a_FQq2AtiPkVS0VRy_nBDTyvtOktJUI5lCISmzcEBYg"
        ],
        "estimatedBytes": 93644,
        "existing": null,
        "speechSha256": "3ff49306a264fc8663e8d29bead4907dc91940b827f54ac43accba50e6f566df",
        "speechText": "「大きなもんだなあ」"
      },
      {
        "action": "generate",
        "audioId": "185ef04ddad5d5ae06a2ab7ad45113ebb804c2dcb283b8d010b033f29a29d374",
        "candidateIds": [
          "xc8goMNo27ef0LJotF4JAdKEtb-gYtYzfUwoC1_vs_A"
        ],
        "estimatedBytes": 233948,
        "existing": null,
        "speechSha256": "84e22e436293a61e215c4504a4d1561a8e8411a85606127d1329fb73a4be0d25",
        "speechText": "「人間をこしらえるよりもよっぽど骨が折れるだろう」"
      },
      {
        "action": "generate",
        "audioId": "18db5f3faa060b1cda8f82cc7f28e2f77da6eef93c10b1b94638741d9d06a565",
        "candidateIds": [
          "9wwWCBmRYIu0VDTubPmzarP_VypC3FW2pyWXq_Cb00s"
        ],
        "estimatedBytes": 449132,
        "existing": null,
        "speechSha256": "cc8c155c44fc34b4a590af6d11051b12673be69dc8984bc88fe729a8d6d20f44",
        "speechText": "「負ぶってもらってすまないが、どうも人に馬鹿にされていけない。親にまで馬鹿にされるからいけない」"
      },
      {
        "action": "generate",
        "audioId": "1e699b4b0a12d41fc89fe7bcf47577da15d5c4da06ff1e6f77d58f071656c849",
        "candidateIds": [
          "rBwuyxurZocMzETe4ditTouQDpCvGK5TScM-UkuVIgA"
        ],
        "estimatedBytes": 701708,
        "existing": null,
        "speechSha256": "0a3fd2361791494c6c5b662257c196f7210c4deac47027180303850a55ac58e8",
        "speechText": "「どうも強そうですね。なんだってえますぜ。昔から誰が強いって、仁王ほど強い人あ無いって云いますぜ。何でもやまとだけのみことよりも強いんだってえからね」"
      },
      {
        "action": "generate",
        "audioId": "2040241f8383666de77bac3233706db3d4c38e411f29734825da382018341137",
        "candidateIds": [
          "QUXAfc-xFigCmbMAcnuIIc5CPP46B1lzgq16ozjprAA"
        ],
        "estimatedBytes": 65564,
        "existing": null,
        "speechSha256": "1c5450e69d784a8102386277f702b861672d99b6156485ec757ff52de003e776",
        "speechText": "「重かあない」"
      },
      {
        "action": "generate",
        "audioId": "243391a69550b20db9473c2b398660202edb52a31f9c76b5513ceaf22c1c2499",
        "candidateIds": [
          "5dpoWgQQqXtYNP7c6cJ-bBx28mhO_urD0iYbe78YU8k"
        ],
        "estimatedBytes": 159116,
        "existing": null,
        "speechSha256": "b9f85aa5c9d1fb4dbf667c37001fcd12157f429246e3b88b6b44ccedd330928e",
        "speechText": "「どうも盲目は不自由でいけないね」"
      },
      {
        "action": "generate",
        "audioId": "25279a46289c48a8b4f21a88d8b061e3f997306abc6d0c566ce9c2749de53beb",
        "candidateIds": [
          "mAbEvxbQvNhtzYRVngXdfBliOiFRRfNeBnYfrX3pqL0"
        ],
        "estimatedBytes": 159116,
        "existing": null,
        "speechSha256": "a509bdf42552afbe3ed93a6fc0431e6b1f41401ae96adfb167a134cfe163efa2",
        "speechText": "「見ておろう、見ておろう、好いか」"
      },
      {
        "action": "generate",
        "audioId": "2d5926d99d83e8153ddb401a434cc9ed1edfc9cdc6895c44f50e0a4b36f021a8",
        "candidateIds": [
          "ZtjcFxbyYU3ftUkRjlhiinXHwwXyNwckMKsGz8GtML8"
        ],
        "estimatedBytes": 112316,
        "existing": null,
        "speechSha256": "8fa5671105d41bf0c3dc73b6bb2548db13e0117e034d67571d44c2564c576094",
        "speechText": "「おとっさん、重いかい」"
      },
      {
        "action": "generate",
        "audioId": "2f06636ff5e69742978bf081d6ce5e2822a7f1835123b136b4d26f1588c2dd15",
        "candidateIds": [
          "WcfJeD-kcvYOuUKNwUZ66cpUCUcW-qKz35Dv83fWP5I"
