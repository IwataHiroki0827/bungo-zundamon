        "speechSha256": "a2cff0b6798d68004f8ebf4b1943c6097e0c3e7e80d34a345e3ab960489071d2",
        "speechText": "「今にその手拭がへびになるから、見ておろう。見ておろう」"
      },
      {
        "action": "generate",
        "audioId": "0537a030c3b2b9cac3ef36e9cdee3b464d0f7726404fcea545d52a14299cd416",
