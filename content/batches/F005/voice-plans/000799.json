        "estimatedBytes": 74924,
        "existing": null,
        "speechSha256": "3716326d947b581a4a08bdd80113b1db692c1844d485f362921f7639ca2ce97c",
        "speechText": "「洗いましょう」"
      },
      {
        "action": "generate",
        "audioId": "30ce5eaefa889f0683d74ef6ecd99e209b276f404d475cbae1bb21774def3d12",
        "candidateIds": [
          "qfL1jCdiSpMyQ3jEeq0WJYy__tyZfBxrO2ZM3ECHnb0"
