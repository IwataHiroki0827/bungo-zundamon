        "existing": null,
        "speechSha256": "3df048cde67d3da87fcfba8df785345934600ed5e8cdfd95fd72ebd7f9b799ae",
        "speechText": "「だってさぎが鳴くじゃないか」"
      },
      {
        "action": "generate",
        "audioId": "05bbf0597d249ce0d9b11e6338b72596c114aee4f2c5ca65682d77878f630e65",
