    },
    {
      "candidateId": "tbhKJBSKZ-xBK7ogTDpYxAf6yjFJwXWlU438_oNkQLw",
      "displayText": "「レエス」",
      "order": 37,
      "sha256": "9202cc09f9f78d7cb165c887cb09a9502b10e4538426eee717d1243ec3a2565a",
      "sourceAnchor": ".main_text:13675-13680",
