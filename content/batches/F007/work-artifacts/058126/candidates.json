    {
      "candidateId": "tCtMEcnY8SN0OiADlxssTm2QTym4cHcwueGK7RrGzYs",
      "displayText": "「よくぞ帰り来たまいし。帰り来たまわずばわが命は絶えなんを」",
      "order": 35,
      "sha256": "7ca30b259476844e22ed2bf23b9af3be6412bf4d00dfe088e0b4804784083b93",
      "sourceAnchor": ".main_text:13414-13444",
      "speechText": "「よくぞ帰り来たまいし。帰り来たまわずばわが命は絶えなんを」"
    },
    {
      "candidateId": "ydSe_mp5ghfrFtZKjmsNO3yP56NvRt7PKy88vh7L6ns",
      "displayText": "「幾階か持ちて行くべき」",
