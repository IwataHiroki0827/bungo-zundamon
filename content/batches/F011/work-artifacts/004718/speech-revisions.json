    {
      "candidateId": "GC6-b2pmj-29krnXBwA1hVpQ9SbkONeirj5POmM6p5c",
      "displayText": "「やあ、きみは黄色だね。きたない色だ。」",
      "revisionCount": 0,
      "speechSha256": "ba98d5df0bd240f6430f73910c4cd4746eabb38d6c8d61615fda1815c396f469",
      "speechText": "「やあ、きみは黄色だね。きたない色だ。」"
    },
    {
      "candidateId": "FFUC7fmiO9W1PvNXr0z_9tyS9r2Mf2DhICmcB4xoAfc",
      "displayText": "「きみは緑だね。きみはじぶんを美しいと思っているのかね。」",
      "revisionCount": 0,
      "speechSha256": "e60a765b4a8795c623398d8dbdccd913030dacf3e5608f89ecf3271fe4d68a23",
      "speechText": "「きみは緑だね。きみはじぶんを美しいと思っているのかね。」"
    },
    {
      "candidateId": "86KWYENjL-fR3OLWkmkYWYxz9LZjl9epuZlCw_k_pq4",
      "displayText": "「春になったら、このけんかの勝負をつける。」",
      "revisionCount": 0,
      "speechSha256": "871e194db63f8b9b1ee4981e952dd9401913efba95ab07fb5b7e90f9a731d431",
      "speechText": "「春になったら、このけんかのしょうぶをつける。」"
    },
    {
      "candidateId": "nrWaNpcNRiqW5ujJithU59k3LC6ldaw__w769AC91tA",
      "displayText": "「いまいったことをわすれるな。」",
      "revisionCount": 0,
      "speechSha256": "de0e4538faf068eeb1bf64fd7d14af3e6d266523cfecf824678f463cb9a0738d",
      "speechText": "「いまいったことをわすれるな。」"
    },
    {
      "candidateId": "p43L-wUNnPYiBvnJYr7CClXcbC4Dq-lq5McYwyhHpRk",
      "displayText": "「おいおい、おきたまえ。もう春だぞ。」",
